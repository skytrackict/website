# Contentful (content storage for enrolments, bookings & contact messages)
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=
VITE_CONTENTFUL_ENVIRONMENT=master

# OPTIONAL — only needed if you want the site to write enrolments/bookings/
# contact messages directly into Contentful from the browser. See the
# "Contentful write access" section of README.md for the security trade-offs
# before enabling this in production.
VITE_CONTENTFUL_MANAGEMENT_TOKEN=

# Paystack (frontend-only inline checkout)
VITE_PAYSTACK_PUBLIC_KEY=

# Optional — used for canonical/OG URLs if you deploy on a different domain
VITE_SITE_URL=https://skytrackict.com.ng
